#!/usr/bin/env bash
# Installs the SDDM astronaut theme and sets the login background.
# Reruns when the commit, variant or login image changes.
# login-bg.png hash: {{ include "Pictures/wallpaper/login-bg.png" | sha256sum }}
set -euo pipefail

repo=https://github.com/Keyitdev/sddm-astronaut-theme.git
commit=abb3163c724935af888ba5ea9ac0c4f22afd8048
variant=astronaut
theme=/usr/share/sddm/themes/sddm-astronaut-theme

# Skip machines without SDDM
command -v sddm >/dev/null || exit 0

# Download the pinned commit into a temporary folder
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
git -C "$tmp" init --quiet
git -C "$tmp" fetch --quiet --depth 1 "$repo" "$commit"
git -C "$tmp" checkout --quiet FETCH_HEAD
rm -rf "$tmp/.git"

# Install the theme (replaces any previous version)
sudo rm -rf "$theme"
sudo mkdir -p "$theme"
sudo cp -r "$tmp/." "$theme/"

# Install its fonts into their own folder
sudo mkdir -p /usr/share/fonts/sddm-astronaut
sudo cp -r "$theme/Fonts/." /usr/share/fonts/sddm-astronaut/
sudo fc-cache -f >/dev/null

# Select the variant and make it the active theme
sudo mkdir -p /etc/sddm.conf.d
sudo sed -i "s|^ConfigFile=.*|ConfigFile=Themes/$variant.conf|" "$theme/metadata.desktop"
sudo tee /etc/sddm.conf.d/theme.conf >/dev/null <<EOF
[Theme]
Current=sddm-astronaut-theme
EOF

# Set the login background
sudo install -m 644 "$HOME/Pictures/wallpaper/login-bg.png" "$theme/Backgrounds/login-bg.png"
sudo tee "$theme/Themes/$variant.conf.user" >/dev/null <<EOF
[General]
Background="Backgrounds/login-bg.png"
EOF
